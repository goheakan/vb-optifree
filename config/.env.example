# vb-optifree — secrets locaux.
# Ce fichier doit rester en mode 600 et ne jamais être versionné.

# Clé locale de la passerelle LiteLLM.
# L'installateur la remplace par une valeur aléatoire s'il détecte le
# placeholder ci-dessous. Tu peux aussi la générer toi-même :
#   openssl rand -hex 24
LITELLM_MASTER_KEY=change-me

# Optionnel : spend tracking persistant
# LITELLM_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/litellm

# --- Fournisseurs cloud gratuits ---
# Groq : https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Fallback payant quasi-gratuit ---
# DeepSeek : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Optionnels ---
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
