{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (local)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "sensitive": {
          "name": "Local privé (hors service tant qu'Ollama n'est pas branché)"
        },
        "local-coder": {
          "name": "Ollama (hors service pour l'instant)"
        },
        "local-fast": {
          "name": "Ollama rapide (hors service pour l'instant)"
        },
        "default": {
          "name": "Défaut LiteLLM (Groq, puis DeepSeek, puis Gemini)"
        },
        "groq-120b": {
          "name": "Groq GPT-OSS 120B (gratuit)"
        },
        "gemini-flash": {
          "name": "Gemini Flash (gratuit)"
        },
        "openrouter-free": {
          "name": "OpenRouter :free (hors chaîne tant que l'identifiant n'est pas fixé)"
        },
        "deepseek-flash": {
          "name": "DeepSeek (payant, avant Gemini dans l'ordre par défaut)"
        }
      }
    }
  },
  "plugins": ["./opencode-quota"]
}
