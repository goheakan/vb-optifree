{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (local)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "sensitive": {
          "name": "Local privé (Ollama, aucun cloud)"
        },
        "default": {
          "name": "Défaut (cloud gratuit + fallback local)"
        },
        "local-coder": {
          "name": "Ollama 14B (local)"
        },
        "local-fast": {
          "name": "Ollama 7B (local rapide)"
        },
        "groq-120b": {
          "name": "Groq GPT-OSS 120B (gratuit)"
        },
        "gemini-flash": {
          "name": "Gemini Flash (gratuit)"
        },
        "openrouter-free": {
          "name": "OpenRouter :free"
        },
        "deepseek-flash": {
          "name": "DeepSeek (payant quasi-gratuit)"
        }
      }
    }
  },
  "plugins": ["./opencode-quota"]
}
